#!/bin/bash
# Post-installation script for ddns-dynv6

set -e

# Source debconf library
. /usr/share/debconf/confmodule

CONFIG_FILE="/etc/ddns-dynv6.conf"
STATE_DIR="/var/lib/ddns-dynv6"

# Create state directory
mkdir -p "$STATE_DIR"

# Create/update configuration file from debconf values
write_config() {
    db_get ddns-dynv6/interface
    local interface="$RET"
    
    db_get ddns-dynv6/token
    local token="$RET"
    
    db_get ddns-dynv6/domains
    local domains="$RET"
    
    # Write configuration file
    cat > "$CONFIG_FILE" << EOF
# ddns-dynv6 configuration file
# Generated by debconf on $(date +%Y-%m-%d)

# Network interface to monitor for IPv6 address changes
INTERFACE="${interface}"

# Your dynv6 API token
TOKEN="${token}"

# Domain(s) to update (space-separated)
DOMAINS="${domains}"

# IPv6 netmask
NETMASK="128"
EOF
    
    chmod 600 "$CONFIG_FILE"
}

# Check if configuration is complete
config_complete() {
    [ -f "$CONFIG_FILE" ] || return 1
    
    source "$CONFIG_FILE" 2>/dev/null || return 1
    
    [ -n "$INTERFACE" ] && [ -n "$TOKEN" ] && [ -n "$DOMAINS" ]
}

case "$1" in
    configure)
        # Write configuration from debconf
        write_config
        
        # 先启用 timer，避免 debhelper 打印警告
        if [ -d /run/systemd/system ]; then
            systemctl enable ddns-dynv6.timer >/dev/null 2>&1 || true
        fi
        
        if ! config_complete; then
            echo "Configuration incomplete. Run 'sudo dpkg-reconfigure ddns-dynv6' to complete setup."
        fi
        ;;
    
    reconfigure)
        write_config
        
        # Trigger update after reconfiguration
        if config_complete; then
            echo "Triggering DNS update after reconfiguration..."
            systemctl start ddns-dynv6.service || true
        fi
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        ;;
esac

#DEBHELPER#

exit 0